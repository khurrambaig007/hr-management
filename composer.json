{
    "name": "khurrambaig/hr-management",
    "description": "HR management package: departments, employees, attendance, leaves and annual leave settlements for Laravel 11, 12 and 13.",
    "keywords": ["laravel", "hr", "management", "attendance", "leaves", "settlements", "human-resources"],
    "homepage": "https://github.com/khurrambaig007/hr-management",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mirza Khurram Baig",
            "email": "khurram0072005@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/khurrambaig007/hr-management/issues",
        "source": "https://github.com/khurrambaig007/hr-management"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "Khurrambaig\\HRManagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Khurrambaig\\HRManagement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Khurrambaig\\HRManagement\\HRManagementServiceProvider"
            ],
            "aliases": {
                "HRManagement": "Khurrambaig\\HRManagement\\HRManagementFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}